<mujoco model="Lidar Example">
    <option timestep="0.002" gravity="0 0 -9.81" />
    <compiler angle="radian" />

    <visual>
        <headlight ambient="0.4 0.4 0.4" diffuse="0.4 0.4 0.4" specular="0.0 0.0 0.0" active="1" />
        <quality shadowsize="0" />
    </visual>

    <asset>
        <texture builtin="checker" height="512" name="texplane" rgb1=".2 .3 .4" rgb2=".1 .15 .2" type="2d" width="512" />
        <material name="MatPlane" reflectance="0.2" texrepeat="1 1" texture="texplane" texuniform="true" />
    </asset>

    <worldbody>
        <light pos="0 0 10" castshadow="false" />
        <geom name="ground_plane" type="plane" size="20 20 0.1" material="MatPlane" />

        <!-- obstacles -->
        <geom type="box" pos="4 -2 0.5" size="0.3 0.3 0.5" rgba="0.9 0.2 0.2 1" />
        <geom type="box" pos="5 2 1.0" size="0.5 0.5 1.0" rgba="0.2 0.9 0.2 1" />
        <geom type="cylinder" pos="-3 1 0.75" size="0.3 0.75" rgba="0.2 0.2 0.9 1" />
        <geom type="box" pos="0 -6 1.5" size="6 0.1 1.5" rgba="0.8 0.8 0.8 1" />
        <!-- slope and steps for terrain perception -->
        <geom type="box" pos="-4 -3 0.2" size="1.5 1 0.05" euler="0 0.25 0" rgba="0.7 0.6 0.4 1" />
        <geom type="box" pos="2 4 0.1" size="0.4 1 0.1" rgba="0.6 0.6 0.3 1" />
        <geom type="box" pos="2.8 4 0.2" size="0.4 1 0.2" rgba="0.6 0.6 0.3 1" />
        <geom type="box" pos="3.6 4 0.3" size="0.4 1 0.3" rgba="0.6 0.6 0.3 1" />

        <body name="lidar_body" pos="0 0 0.5">
            <freejoint />
            <geom type="box" size="0.15 0.15 0.05" pos="0 0 -0.05" rgba="0.3 0.3 0.3 1" mass="2" />
            <!-- Mid-360 is ~65 mm in diameter; mount it on top -->
            <geom type="cylinder" size="0.0325 0.03" pos="0 0 0.03" rgba="0.1 0.1 0.1 1" mass="0.265" />
            <site name="mid360_site" pos="0 0 0.05" size="0.01" />
            <!-- built-in IMU: (0.011, 0.02329, -0.04412) from the optical center -->
            <site name="mid360_imu" pos="0.011 0.02329 0.00588" size="0.005" />
        </body>
    </worldbody>
</mujoco>
